# Never commit the real .env file. Generate a unique key for every environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ENV=development
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. DATABASE_URL takes precedence when it is set.
DATABASE_URL=
POSTGRES_DB=task_management_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Production: require TLS; use verify-full and a trusted CA when supported.
POSTGRES_SSLMODE=require
POSTGRES_SSLROOTCERT=

# Redis. Production requires rediss://; verification is strict except for the
# user-approved Heroku KVS compatibility mode described below.
REDIS_URL=redis://127.0.0.1:6379/0
# Optional overrides; omit them on Heroku to inherit the addon REDIS_URL.
# REDIS_BROKER_URL=redis://127.0.0.1:6379/0
# REDIS_RESULT_BACKEND=redis://127.0.0.1:6379/1
# REDIS_CACHE_BACKEND=redis://127.0.0.1:6379/2
REDIS_SSL_CA_CERTS=
# User-approved Heroku KVS compatibility: TLS without certificate verification
# is automatic only on Heroku without a custom CA. Everywhere else is strict.
# Set this false with REDIS_SSL_CA_CERTS to opt in to verified TLS on Heroku.
# HEROKU_REDIS_COMPATIBILITY=False

CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:3000

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_TOKEN_TTL_MINUTES=10

# Enable only behind a proxy that appends (rather than preserves) this header.
TRUST_X_FORWARDED_FOR=False
TRUSTED_PROXY_COUNT=1
TRUSTED_PROXY_IPS=127.0.0.1,::1
TRUST_X_FORWARDED_PROTO=False

# Optional development-only API docs; leave unset for secure production defaults.
# API_DOCS_PUBLIC=True
# ENABLE_API_DOCS=True
LOG_LEVEL=INFO
